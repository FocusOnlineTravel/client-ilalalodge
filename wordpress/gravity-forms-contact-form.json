{
  "version": "3.0.2",
  "0": {
    "title": "Contact Form",
    "description": "Ilala Lodge website contact form. Routes to the correct inbox based on enquiry type.",
    "labelPlacement": "top_label",
    "descriptionPlacement": "below",
    "button": {
      "type": "text",
      "text": "Send Enquiry",
      "imageUrl": "",
      "width": "auto",
      "location": "bottom",
      "layoutGridColumnSpan": 12
    },
    "cssClass": "ilala-contact-form",
    "enableHoneypot": true,
    "requireLogin": false,
    "requireLoginMessage": "",
    "fields": [
      {
        "type": "radio",
        "id": 1,
        "label": "Enquiry Type",
        "adminLabel": "enquiry_type",
        "isRequired": true,
        "size": "medium",
        "choices": [
          { "text": "General Enquiry", "value": "general", "isSelected": true, "price": "" },
          { "text": "Accommodation Enquiry", "value": "accommodation", "isSelected": false, "price": "" }
        ],
        "inputs": null,
        "descriptionPlacement": "below",
        "labelPlacement": "",
        "cssClass": "gf-enquiry-type"
      },
      {
        "type": "text",
        "id": 2,
        "label": "Full Name",
        "adminLabel": "name",
        "isRequired": true,
        "size": "medium",
        "placeholder": "Jane Smith"
      },
      {
        "type": "email",
        "id": 3,
        "label": "Email",
        "adminLabel": "email",
        "isRequired": true,
        "size": "medium",
        "placeholder": "jane@example.com"
      },
      {
        "type": "phone",
        "id": 4,
        "label": "Phone",
        "adminLabel": "phone",
        "isRequired": false,
        "size": "medium",
        "phoneFormat": "international",
        "placeholder": "+44 20 1234 5678",
        "description": "Optional"
      },
      {
        "type": "date",
        "id": 5,
        "label": "Arrival",
        "adminLabel": "arrival",
        "isRequired": false,
        "size": "medium",
        "dateType": "datepicker",
        "dateFormat": "ymd_dash",
        "conditionalLogic": {
          "actionType": "show",
          "logicType": "all",
          "rules": [
            { "fieldId": "1", "operator": "is", "value": "accommodation" }
          ]
        }
      },
      {
        "type": "date",
        "id": 6,
        "label": "Departure",
        "adminLabel": "departure",
        "isRequired": false,
        "size": "medium",
        "dateType": "datepicker",
        "dateFormat": "ymd_dash",
        "conditionalLogic": {
          "actionType": "show",
          "logicType": "all",
          "rules": [
            { "fieldId": "1", "operator": "is", "value": "accommodation" }
          ]
        }
      },
      {
        "type": "number",
        "id": 7,
        "label": "Number of Guests",
        "adminLabel": "guests",
        "isRequired": false,
        "size": "medium",
        "rangeMin": 1,
        "rangeMax": 20,
        "defaultValue": "2",
        "numberFormat": "decimal_dot",
        "conditionalLogic": {
          "actionType": "show",
          "logicType": "all",
          "rules": [
            { "fieldId": "1", "operator": "is", "value": "accommodation" }
          ]
        }
      },
      {
        "type": "select",
        "id": 8,
        "label": "Room Preference",
        "adminLabel": "room_preference",
        "isRequired": false,
        "size": "medium",
        "placeholder": "Any room type",
        "choices": [
          { "text": "Any room type", "value": "Any room type", "isSelected": true, "price": "" },
          { "text": "Classic Rooms", "value": "Classic Rooms", "isSelected": false, "price": "" },
          { "text": "Classic Suites", "value": "Classic Suites", "isSelected": false, "price": "" },
          { "text": "Deluxe Rooms", "value": "Deluxe Rooms", "isSelected": false, "price": "" },
