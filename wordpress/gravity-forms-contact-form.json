          { "text": "Strathearn Suite", "value": "Strathearn Suite", "isSelected": false, "price": "" }
        ],
        "conditionalLogic": {
          "actionType": "show",
          "logicType": "all",
          "rules": [
            { "fieldId": "1", "operator": "is", "value": "accommodation" }
          ]
        }
      },
