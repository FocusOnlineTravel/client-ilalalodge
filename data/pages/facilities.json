    {
      "acf_fc_layout": "text_block",
      "heading": "",
      "body": "<p>Ilala Lodge Hotel offers a range of facilities designed to enhance your stay. From relaxed poolside spaces to conferencing and curated activities, each element is designed for comfort and ease.</p>",
      "text_align": "center",
      "max_width": "medium",
      "section_theme": "accent",
