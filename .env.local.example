# WordPress API Configuration
# Copy this file to .env.local and fill in your values

# WordPress URL (no trailing slash)
WP_URL=https://cms.ilalalodge.com
NEXT_PUBLIC_WP_URL=https://cms.ilalalodge.com

# Enable WordPress as data source
# Set to 'true' to fetch from WordPress REST API
# Leave commented or set to 'false' to use local JSON files
# NEXT_PUBLIC_USE_WORDPRESS=true

# WordPress username
WP_USER=your-username

# WordPress Application Password (create in Users > Profile > Application Passwords)
# Include spaces as generated
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Preview mode secret (random string)
PREVIEW_SECRET=your-random-preview-secret

# Revalidation secret for on-demand ISR
REVALIDATION_SECRET=your-random-revalidation-secret

# Gravity Forms REST API v2 credentials
# Create in WP admin: Forms > Settings > REST API > Add Key (Read/Write permissions)
GF_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GF_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gravity Forms form ID for the contact form (integer, shown in Forms list)
GF_CONTACT_FORM_ID=1
